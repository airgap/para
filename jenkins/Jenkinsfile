// airgap/para CI. Owns the Para ecosystem's verification + the publishes
// para owns (boundary doc /raid/para-design/para-parabun-boundary.md):
//
//   • parity gate (BLOCKING) — corpus vs the PINNED parabun binary (B3).
//     A mirror that drifts from the pinned parser fails here.
//   • nightly canary (NON-BLOCKING) — same corpus vs the LATEST parabun
//     release. Early warning for "stale-but-green" pin drift; reports,
//     never fails (P2-d).
//   • @lyku/para-preprocess — owns the post-extraction source (the
//     .pui lowering: multi-line derived, single-stmt effect, mount
//     retirement, lifecycle auto-import, ./pui ambient). parabun's copy
//     is a stale dup pending deletion and no longer published.
//   • @lyku/para-ui (the para-svelte pnpm fork) + the .vsix
//     (editors/{vscode,lsp,ts-plugin}) — extracted from parabun
//     2026-05-16; para publishes them now.
//
// parabun's Jenkins still owns: the parabun binary, GH release, docker,
// and the @lyku/parabun-bin-<os>-<arch> carriers + @lyku/para-signals.
// @lyku/para-transpile stays unpublished (private/0.0.0-dev) until full
// desugaring + parity completeness — NOT published here.

pipeline {
	agent none

	environment {
		CI = 'true'
	}

	triggers {
		pollSCM('H/5 * * * *')
		// Nightly canary — drift early-warning, decoupled from parabun's
		// release cadence.
		cron('H 3 * * *')
	}

	options {
		timestamps()
		ansiColor('xterm')
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '10'))
		timeout(time: 60, unit: 'MINUTES')
	}

	parameters {
		string(name: 'PARABUN_PIN', defaultValue: '',
		       description: 'airgap/parabun release tag to pin for the BLOCKING parity gate. Empty = read packages/parabun-bin/manifest.json version (the committed pin). The lockfile/manifest is the source of truth; this is an override.')
		booleanParam(name: 'RUN_CANARY', defaultValue: false,
		             description: 'Force the non-blocking canary (parity vs LATEST parabun). Auto-on for the nightly cron build.')
		booleanParam(name: 'RUN_BENCH', defaultValue: false,
		             description: 'Force the non-blocking perf bench (parabun vs the @lyku/para-transpile mirror over the lyku corpus). Auto-on for the nightly cron build.')
		booleanParam(name: 'PUBLISH_NPM', defaultValue: false,
		             description: 'Publish @lyku/para-preprocess + @lyku/para-ui (pnpm-built) + package the .vsix. Off by default. Uses Doppler NPM_ACCESS_TOKEN (ci-deploy/prd).')
	}

	stages {
		// Catalog → derived-files drift check (grammars / LSP allowlist /
		// splash highlighter from src/language-surface.ts). Extracted from
		// parabun 2026-05-17 with editors/*. Fast, no build cost; runs
		// first so a forgotten `bun run codegen` fails fast. para-site
		// targets are skipped when /raid/para-site isn't checked out.
		stage('Codegen check') {
			agent {
				dockerfile {
					filename 'jenkins/Dockerfile.ci-linux'
					label 'linux'
					additionalBuildArgs '--pull'
					customWorkspace '/raid/jenkins-workspaces/para-codegen'
				}
			}
			steps {
				checkout scm
				sh 'bun run codegen:check'
			}
		}

		stage('Verify (test + BLOCKING parity)') {
			agent {
				dockerfile {
					filename 'jenkins/Dockerfile.ci-linux'
					label 'linux'
					additionalBuildArgs '--pull'
					customWorkspace '/raid/jenkins-workspaces/para-verify'
					args '-v /etc/default/jenkins-doppler:/etc/default/jenkins-doppler:ro'
				}
			}
			steps {
				checkout scm
				withCredentials([usernamePassword(
					credentialsId: 'github-pat',
					usernameVariable: 'GH_USER',
					passwordVariable: 'GH_TOKEN',
				)]) {
					sh '''
						set -eu
						export HOME="${WORKSPACE}"

						# Resolve the PINNED parabun for the blocking parity
						# gate. The committed manifest is the pin (B2);
						# PARABUN_PIN param overrides.
						PIN="${PARABUN_PIN:-}"
						if [ -z "$PIN" ]; then
							PIN=$(node -p "require('./packages/parabun-bin/manifest.json').version")
						fi
						echo "pinned parabun: $PIN"

						# The pinned-binary parity infra is not operational yet
						# (scaffold pin `0.0.0-pin.*`, no parabun-* GH release —
						# P2-c carrier publish + bake-manifest pending). Parity
						# CANNOT run without a real pinned binary; that must NOT
						# hard-block the rest of CI (esp. publishing). Degrade
						# gracefully: try the fetch, and if the pin is a
						# placeholder or the release is absent, skip parity with
						# a loud warning and still run the non-parabun tests.
						PARITY_OK=0
						case "$PIN" in
							0.0.0-pin.*|"") echo "::warning:: scaffold/placeholder pin ($PIN) — parity skipped (pinned-binary infra not yet live)";;
							*)
								mkdir -p .parabun
								TAG="parabun-${PIN##*-}"
								if gh release download "$TAG" --repo airgap/parabun --pattern 'parabun-linux-x64' --dir .parabun --clobber; then
									chmod +x .parabun/parabun-linux-x64
									export PARABUN_BIN="$PWD/.parabun/parabun-linux-x64"
									"$PARABUN_BIN" --revision && PARITY_OK=1
								else
									echo "::warning:: pinned parabun release $TAG unavailable on airgap/parabun — parity skipped (NOT a parity failure)"
								fi
								;;
						esac

						bun install
						bunx nx run-many --target=install --projects=parabun-lsp,parabun-ts-plugin,parabun-vscode,para-svelte --parallel=4 || true

						# Always run the parser-independent unit suites. Only
						# add the parity + LSP-smoke projects (which need the
						# pinned binary) when it's actually available.
						PROJECTS=para-transpile,para-preprocess,para-signals,para-codemod,parabun-bin
						if [ "$PARITY_OK" = 1 ]; then
							PROJECTS="$PROJECTS,parity,parabun-lsp"
						fi
						bunx nx run-many --target=test --projects="$PROJECTS" --parallel=4 --output-style=stream
					'''
				}
			}
		}

		stage('Nightly canary (NON-BLOCKING)') {
			when {
				anyOf {
					triggeredBy 'TimerTrigger'
					expression { params.RUN_CANARY }
				}
			}
			agent {
				dockerfile {
					filename 'jenkins/Dockerfile.ci-linux'
					label 'linux'
					customWorkspace '/raid/jenkins-workspaces/para-canary'
				}
			}
			steps {
				checkout scm
				withCredentials([usernamePassword(
					credentialsId: 'github-pat',
					usernameVariable: 'GH_USER',
					passwordVariable: 'GH_TOKEN',
				)]) {
					// Never fail the pipeline on drift — the canary only
					// reports. runner.ts --canary already exits 0; catchError
					// is belt-and-suspenders for the fetch/build steps.
					catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
						sh '''
							set -eu
							export HOME="${WORKSPACE}"
							# LATEST parabun release (not the pin).
							LATEST=$(gh release list --repo airgap/parabun \
								--limit 1 --json tagName --jq '.[0].tagName')
							echo "latest parabun: $LATEST"
							mkdir -p .parabun
							gh release download "$LATEST" --repo airgap/parabun \
								--pattern 'parabun-linux-x64' --dir .parabun --clobber
							chmod +x .parabun/parabun-linux-x64
							export PARABUN_BIN="$PWD/.parabun/parabun-linux-x64"

							bun install
							bunx nx run parity:canary --skip-nx-cache
						'''
					}
				}
			}
		}

		// Differential perf trend (NON-BLOCKING) — packages/para-bench.
		// Times the LATEST parabun release and the @lyku/para-transpile
		// mirror over the lyku monorepo corpus (the largest Para codebase),
		// compares against the previous run's baseline kept in this
		// persistent workspace, and goes UNSTABLE (never FAILED) on a >25%
		// regression. Trend signal only; the blocking perf/behavior gate
		// belongs on parabun's side (the lyku-integration required check).
		stage('Bench (nightly perf trend)') {
			when {
				anyOf {
					triggeredBy 'TimerTrigger'
					expression { params.RUN_BENCH }
				}
			}
			agent {
				dockerfile {
					filename 'jenkins/Dockerfile.ci-linux'
					label 'linux'
					customWorkspace '/raid/jenkins-workspaces/para-bench'
				}
			}
			steps {
				checkout scm
				// Macro corpus: HOST-side sparse shallow lyku checkout into the
				// persistent workspace. Must not run in-container: t.muzz.in's
				// ssh only resolves through the host's ssh config (Cloudflare
				// fronts the DNS name and does not proxy ssh), and GitSCM
				// checkout executes on the host launcher even under a docker
				// agent (JENKINS-30600) — which is exactly what we need.
				dir('.bench-corpus') {
					checkout([
						$class: 'GitSCM',
						branches: [[name: '*/main']],
						extensions: [
							[$class: 'CloneOption', depth: 1, shallow: true, noTags: true],
							[$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
								[$class: 'SparseCheckoutPath', path: 'org/'],
								[$class: 'SparseCheckoutPath', path: 'co/'],
								[$class: 'SparseCheckoutPath', path: 'framework/']
							]]
						],
						userRemoteConfigs: [[url: 'git@t.muzz.in:muzzin/lyku.git', credentialsId: 'gitea-ssh']]
					])
				}
				withCredentials([usernamePassword(
					credentialsId: 'github-pat',
					usernameVariable: 'GH_USER',
					passwordVariable: 'GH_TOKEN',
				)]) {
					catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
						sh '''
							set -eu
							export HOME="${WORKSPACE}"

							# LATEST parabun release — the binary about to be pinned
							# is the one whose speed we want on the trend line.
							LATEST=$(gh release list --repo airgap/parabun \
								--limit 1 --json tagName --jq '.[0].tagName')
							echo "latest parabun: $LATEST"
							mkdir -p .parabun
							gh release download "$LATEST" --repo airgap/parabun \
								--pattern 'parabun-linux-x64' --dir .parabun --clobber
							chmod +x .parabun/parabun-linux-x64
							export PARABUN_BIN="$PWD/.parabun/parabun-linux-x64"

							echo "corpus at $(git -C .bench-corpus rev-parse --short HEAD)"

							bun install

							# Compare against the previous nightly, then advance
							# the baseline either way — each run is judged against
							# its predecessor, so a regression is flagged exactly
							# once instead of forever.
							BASELINE="$PWD/bench-baseline.json"
							export BENCH_CORPUS="$PWD/.bench-corpus"
							export BENCH_OUT="$PWD/bench.json"
							cd packages/para-bench
							RC=0
							if [ -f "$BASELINE" ]; then
								bun bench.ts --check "$BASELINE" || RC=$?
							else
								bun bench.ts || RC=$?
							fi
							cp "$BENCH_OUT" "$BASELINE"
							exit $RC
						'''
					}
					archiveArtifacts artifacts: 'bench.json', allowEmptyArchive: true, fingerprint: true
				}
			}
		}

		stage('Publish npm (@lyku/para-preprocess + @lyku/para-ui + .vsix)') {
			when { expression { params.PUBLISH_NPM } }
			agent {
				dockerfile {
					filename 'jenkins/Dockerfile.ci-linux'
					label 'linux'
					customWorkspace '/raid/jenkins-workspaces/para-npm-publish'
					args '-v /etc/default/jenkins-doppler:/etc/default/jenkins-doppler:ro'
				}
			}
			steps {
				checkout scm
				sh '''
					set -eu
					set +x
					export HOME="${WORKSPACE}"
					export DOPPLER_TOKEN=$(grep '^DOPPLER_TOKEN_CI_DEPLOY=' /etc/default/jenkins-doppler | cut -d= -f2-)
					NPM_TOKEN=$(doppler secrets get NPM_ACCESS_TOKEN --plain --project ci-deploy --config prd)
					echo "//registry.npmjs.org/:_authToken=$NPM_TOKEN" > "$HOME/.npmrc"
					echo "auth ok: $(npm whoami)"
				'''
				// @lyku/para-preprocess — airgap/para owns this post-
				// extraction (parabun's packages/para-preprocess is a stale
				// dup, no longer published from there). tsc build then
				// publish; idempotent (skip if the version is already on
				// npm). This is what carries the .pui lowering fixes
				// (multi-line derived, single-stmt effect, mount retirement,
				// lifecycle auto-import, ./pui ambient) to Lyku's build.
				sh '''
					set -eu
					export HOME="${WORKSPACE}"
					PKG_VERSION=$(node -p "require('./packages/para-preprocess/package.json').version")
					if npm view "@lyku/para-preprocess@$PKG_VERSION" version >/dev/null 2>&1; then
						echo "@lyku/para-preprocess@$PKG_VERSION already published, skipping publish"
					else
						bun install --ignore-scripts --no-audit --no-fund
						cd packages/para-preprocess
						bun run build
						npm publish --tag pre
						cd "$WORKSPACE"
					fi
					# Always reconcile the `latest` dist-tag to the version this
					# build carries. The very first publish (the old parabun job,
					# pre.0) implicitly set latest=pre.0 and `--tag pre` never
					# moved it since — so consumers on caret prerelease ranges
					# (Lyku: ^0.0.1-pre.*) kept resolving the OLDEST publish via
					# bun's latest-following resolver. Idempotent; runs even on
					# the already-published path so a stale latest self-heals.
					npm dist-tag add "@lyku/para-preprocess@$PKG_VERSION" latest
					echo "dist-tags now: $(npm view @lyku/para-preprocess dist-tags)"
				'''
				// @lyku/para-ui — pnpm-built Svelte fork. Idempotent: skip
				// if the version is already on npm. @lyku/para-signals is a
				// `file:../../../para-signals` dep in `dependencies` for local
				// dev; it MUST be swapped to a real npm semver before publish
				// or every consumer's install fails (the relative path does
				// not exist post-install: `failed to link @lyku/para-signals`).
				// The swap is unconditional + idempotent: the sed only rewrites
				// if the file:-pattern is present, and matches the dep in
				// whichever section it lives (a prior bug guarded on
				// devDependencies while the dep is in dependencies, so the
				// swap silently no-op'd and pre.4 shipped the broken path).
				// Reverted in post.always (`git checkout package.json`).
				sh '''
					set -eu
					export HOME="${WORKSPACE}"
					cd packages/para-svelte/packages/svelte
					PKG_VERSION=$(node -p "require('./package.json').version")
					if npm view "@lyku/para-ui@$PKG_VERSION" version >/dev/null 2>&1; then
						echo "@lyku/para-ui@$PKG_VERSION already published, skipping publish"
					else
						SIGNALS_VERSION="^$(npm view @lyku/para-signals version 2>/dev/null || echo 0.0.1-pre.0)"
						sed -i 's|"@lyku/para-signals": "file:[^"]*"|"@lyku/para-signals": "'"$SIGNALS_VERSION"'"|' package.json
						if grep -q '"@lyku/para-signals": "file:' package.json; then
							echo "FATAL: @lyku/para-signals file: dep not swapped — refusing to publish a broken manifest" >&2
							exit 1
						fi
						pnpm install --frozen-lockfile=false
						pnpm run build
						npm publish --tag pre
					fi
					# Always reconcile `latest` — same rationale as
					# para-preprocess: the first publish pinned latest to the
					# oldest pre.N and `--tag pre` never moves it, so bun's
					# latest-following resolver keeps consumers (Lyku's
					# `svelte: npm:@lyku/para-ui@^…` alias) on the stale build.
					# Idempotent; self-heals on the already-published path.
					npm dist-tag add "@lyku/para-ui@$PKG_VERSION" latest
					echo "dist-tags now: $(npm view @lyku/para-ui dist-tags)"
				'''
				// .vsix — editors/{vscode,lsp,ts-plugin}. nx orchestrates the
				// install + ts-plugin build + copy-assets bundling; vsce
				// packages. PARABUN_VSIX_SKIP_BINARY_CHECK=1: CI ships no
				// parabun on PATH (the check is a local-dev footgun guard).
				sh '''
					set -eu
					export HOME="${WORKSPACE}"
					export PARABUN_VSIX_SKIP_BINARY_CHECK=1
					bun install
					bunx nx build parabun-vscode --skip-nx-cache
					cd editors/vscode/parabun
					mkdir -p ../../../artifacts
					npx --yes @vscode/vsce@^3 package --out ../../../artifacts/parabun.vsix
				'''
			}
			post {
				success {
					archiveArtifacts artifacts: 'artifacts/parabun.vsix', allowEmptyArchive: true
				}
				always {
					sh '''
						export HOME="${WORKSPACE}"
						# Revert the file: dep swap so local dev stays intact.
						cd packages/para-svelte/packages/svelte
						git checkout package.json || true
						rm -f "$HOME/.npmrc" || true
					'''
				}
			}
		}

		// Para owns the VS Code extension as part of ITS offering — parabun
		// is a separate product (it natively understands the Para language;
		// the extension is Para-language editor support: LSP + syntax +
		// reactive-dependents hover). So the .vsix is published as a release
		// asset on a rolling airgap/para release, NOT on parabun's binary
		// release. Its OWN stage, NOT gated by PUBLISH_NPM: every main build
		// (re)builds + (re)publishes it. `vsix-latest` is a stable rolling
		// prerelease (idempotent create + --clobber upload) so there's a
		// constant download URL and no per-commit tag spam. set -eu → a
		// publish failure fails this stage loudly (consistent with the npm
		// publish posture); post.always still archives the Jenkins artifact.
		stage('Package + publish .vsix') {
			agent {
				dockerfile {
					filename 'jenkins/Dockerfile.ci-linux'
					label 'linux'
					additionalBuildArgs '--pull'
					customWorkspace '/raid/jenkins-workspaces/para-vsix'
				}
			}
			steps {
				checkout scm
				withCredentials([usernamePassword(
					credentialsId: 'github-pat',
					usernameVariable: 'GH_USER',
					passwordVariable: 'GH_TOKEN',
				)]) {
					sh '''
						set -eu
						export HOME="${WORKSPACE}"
						export PARABUN_VSIX_SKIP_BINARY_CHECK=1
						bun install
						bunx nx build parabun-vscode --skip-nx-cache
						cd editors/vscode/parabun
						mkdir -p ../../../artifacts
						npx --yes @vscode/vsce@^3 package --out ../../../artifacts/parabun.vsix
						cd "$WORKSPACE"
						TAG=vsix-latest
						if ! gh release view "$TAG" --repo airgap/para >/dev/null 2>&1; then
							gh release create "$TAG" --repo airgap/para --prerelease \
								--title "Parabun VS Code extension (rolling latest)" \
								--notes "Latest airgap/para CI build of the Parabun VS Code extension (Para-language editor support: LSP + syntax + reactive-dependents hover). Asset is overwritten on every airgap/para main build."
						fi
						gh release upload "$TAG" artifacts/parabun.vsix --repo airgap/para --clobber
						echo "published parabun.vsix -> airgap/para release $TAG"
					'''
				}
			}
			post {
				always {
					archiveArtifacts artifacts: 'artifacts/parabun.vsix', allowEmptyArchive: true
				}
			}
		}
	}
}
