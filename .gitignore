node_modules
dist
# para-preprocess dist is COMMITTED (ADR-0025): every svelte config imports
# it and nx graph construction loads those configs, so the built entry must
# exist on any fresh checkout without a bootstrap step. Rebuild with tsc
# (the Codegen stage still rebuilds fresh each CI run).
!packages/para-preprocess/dist
.nx/cache
.nx/workspace-data
tmp
*.log
.DS_Store
*.tsbuildinfo

# generated build artifacts, regenerated by `nx build` / copy-assets in
# CI; must not be committed (specific paths, so Svelte fork source like
# packages/para-svelte/.../src/internal/server is NOT affected).
editors/ts-plugin/out
editors/vscode/parabun/out
editors/vscode/parabun/server
editors/lsp/dist-pui-transform
*.vsix
