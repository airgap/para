{
  "name": "parabun-ts-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "editors/ts-plugin/src",
  "projectType": "application",
  "tags": ["standalone", "tier-b"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": { "command": "bun install", "cwd": "editors/ts-plugin" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node esbuild.mjs", "cwd": "editors/ts-plugin" },
      "dependsOn": ["install"]
    }
  }
}
