{
  "name": "para-svelte",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "para/packages/para-svelte/packages/svelte/src",
  "projectType": "library",
  "tags": [
    "pnpm-managed",
    "scope:para",
    "svelte-fork"
  ],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm install",
        "cwd": "para/packages/para-svelte"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "para/packages/para-svelte"
      },
      "dependsOn": [
        "install"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "para/packages/para-svelte"
      },
      "dependsOn": [
        "install"
      ]
    }
  }
}
