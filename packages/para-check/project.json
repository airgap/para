{
  "name": "para-check",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "para/packages/para-check/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node esbuild.mjs",
        "cwd": "para/packages/para-check"
      },
      "dependsOn": [
        {
          "projects": [
            "parabun-lsp"
          ],
          "target": "install"
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --timeout 60000 test/",
        "cwd": "para/packages/para-check"
      },
      "dependsOn": [
        "build"
      ]
    }
  },
  "tags": [
    "scope:para"
  ]
}
