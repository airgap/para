{
  "name": "para-bench",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "para/packages/para-bench",
  "projectType": "library",
  "targets": {
    "bench": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun bench.ts",
        "cwd": "para/packages/para-bench"
      }
    },
    "bench-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun bench.ts --check ${BENCH_BASELINE:-bench-baseline.json}",
        "cwd": "para/packages/para-bench"
      }
    }
  },
  "tags": [
    "no-tests-yet",
    "scope:para"
  ]
}
